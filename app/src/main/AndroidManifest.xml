<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core functionality: this is a file manager, so browsing, copying,
         renaming, deleting, archiving and sharing files from all of shared and
         removable storage is what the app is for - the "essential core
         functionality" all-files access is reserved for, and the declaration
         made in the Play Console for every release.
         Only this permission is needed: READ_MEDIA_* (Play "Photos & Video"
         policy) is redundant once all-files access is granted, and the app
         never asks for it at runtime; the legacy READ/WRITE_EXTERNAL_STORAGE
         grants were dropped because minSdk is 35, where they no longer apply. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- REQUIRED, contrary to an earlier assumption in this file: Android 8+
         refuses to surface the package installer unless the calling app
         declares this permission - PackageManager.canRequestPackageInstalls()
         always reports false without it, which routed every APK tap to the
         unknown-sources settings screen and never showed the installer. It is
         declared in the Play Console under "Request install packages" as the
         file-manager use case (APKs are still handed to the SYSTEM installer
         via an Intent; nothing is installed in-process). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Needed to surface archive progress notifications (runtime request in
         MainActivity). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="com.baiel.expressivefiles.FilesApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Allows CPU/native profiling of this non-debuggable release build
             from Android Studio and Perfetto/simpleperf. -->
        <profileable
            android:shell="true"
             />
        <activity
            android:name="com.baiel.expressivefiles.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver

            android:name=".ArchiveActionReceiver"

            android:exported="false" />


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- androidx.compose.material3 has no View themes; use the platform one.
         Colors mirror the Vibrant light scheme so route transitions never
         flash against a mismatched window base. -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFCFDF5</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
